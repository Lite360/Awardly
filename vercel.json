{
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/((?!admin|api).*)", "destination": "/index.html" }
  ]
}