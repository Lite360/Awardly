# ──────────────────────────────────────────────
# AWARDLY — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local or any file with real secrets
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
# Neon PostgreSQL connection string
# Get this from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Paystack ──────────────────────────────────
# Paystack secret key (server-side ONLY, never prefix with VITE_)
# Get from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ── Resend ────────────────────────────────────
# Resend API key for transactional email
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gmail SMTP (optional secondary route) ─────
GMAIL_SMTP_USER=your@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_app_password

# ── Vercel Blob ───────────────────────────────
# Provided automatically by Vercel when Blob is enabled
# For local dev: https://vercel.com/docs/storage/vercel-blob/local-development
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# ── Authentication ────────────────────────────
# Secret for signing session tokens (min 32 chars, random)
AUTH_SECRET=replace_with_a_random_32_character_or_longer_secret

# ── Application URLs ──────────────────────────
NEXT_PUBLIC_WEB_URL=http://localhost:5173
NEXT_PUBLIC_ADMIN_URL=http://localhost:5174
API_URL=http://localhost:3001

# ── Public Branding (read from DB in production) ──
# These are fallback defaults only; real config comes from DB
PLATFORM_NAME=Awardly
PLATFORM_TAGLINE=Celebrating excellence. Your vote matters.

# ── Email Sender ──────────────────────────────
EMAIL_FROM_NAME=Awardly
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ── Environment ───────────────────────────────
NODE_ENV=development
